# Example environment variables for the Google Drive backend

# Google OAuth2
CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
# Redirect URI used when creating the OAuth client (must match credential). Example:
REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional: if you already have a refresh token you can paste it here. Otherwise run /auth to obtain one.
REFRESH_TOKEN=

# Server port
PORT=3000
